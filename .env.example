# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit file .env!

# Flask
SECRET_KEY=ganti-dengan-string-acak-panjang
FLASK_DEBUG=0

# Midtrans — ambil di Dashboard Midtrans → Settings → Access Keys
# Sandbox: key diawali "SB-Mid-..." ; Production: tanpa "SB-"
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
MIDTRANS_IS_PROD=false

# Email (Gmail: aktifkan 2-Step Verification lalu buat App Password 16 digit)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=diahbakehouse@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Produk
HARGA_EBOOK=29000

# Admin — untuk /preview-ebook?key=... dan /admin/kirim-ulang/<order_id>?key=...
ADMIN_KEY=ganti-dengan-kunci-rahasia-admin

# Lokasi database SQLite order (di hosting, arahkan ke volume/persistent disk)
DATABASE_PATH=orders.db

# Khusus Windows (develop lokal): folder DLL Pango dari MSYS2 untuk WeasyPrint
# WEASYPRINT_DLL_DIRECTORIES=C:\msys64\mingw64\bin
